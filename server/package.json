{
  "name": "@faresight/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "pnpm --filter @faresight/shared build && node src/worker/main.ts",
    "migrate": "node src/scripts/migrate.ts",
    "buckets": "node src/scripts/setupBuckets.ts",
    "deploy-web": "node src/scripts/deployWeb.ts",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@faresight/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "image-size": "^2.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "ws": "^8.18.3"
  }
}
