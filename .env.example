ADMIN_PASSCODE=
# CONTRIBUTOR_PASSCODE=
# ALLOW_UNAUTHENTICATED_DEMO=1
PUBLIC_BASE_URL=http://localhost:3001
# auto uses configured providers and labels simulations when keys are absent.
PIPELINE_MODE=auto
