PORT=3001
HOST=0.0.0.0
GEMINI_API_KEY=
# OpenAI gpt-live-1.1 voice assistant (WebRTC Live API + Responses delegation)
OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1.1
# OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
# OPENAI_LIVE_VOICE=ballad
# Atlas scopes: tasks.create, operations.read, assets.create, assets.read.
WLT_API_KEY=
# WORLDLABS_API_KEY=        # Alias when WLT_API_KEY is unset.
WLT_API_BASE_URL=https://api.atlas.worldlabs.ai/api/v2
REPLICATE_API_TOKEN=
MBTA_API_KEY=
# Required for admin routes and authenticated pipeline access on a non-loopback bind.
ADMIN_PASSCODE=
# CONTRIBUTOR_PASSCODE=
# ALLOW_UNAUTHENTICATED_DEMO=1
PUBLIC_BASE_URL=http://localhost:3001
# auto uses configured providers and labels simulations when keys are absent.
PIPELINE_MODE=auto
# Finished rooms and dishes go live at once. Set to false to hold them for admin review first.
# AUTO_PUBLISH=false

# Capture storage (optional). When DATABASE_URL and the VULTR_S3_* values are all set, room photos go from
# the phone straight to Vultr Object Storage, Tiger Data tracks them, and finished splats are served
# from the splat bucket. Leave them unset to keep photos and splats on this server's disk.
# For local development: docker compose up -d, then use the commented values.
# DATABASE_URL=postgres://faresight:faresight@localhost:54329/faresight
# DATABASE_URL_DIRECT=            # Unpooled Tiger Data URL for LISTEN/NOTIFY. Defaults to DATABASE_URL.
# VULTR_S3_ENDPOINT=http://localhost:9009      # e.g. https://ewr1.vultrobjects.com
# VULTR_S3_REGION=us-east-1
# VULTR_S3_ACCESS_KEY=faresight
# VULTR_S3_SECRET_KEY=faresight-secret
# RAW_BUCKET=faresight-raw        # Private: the uploaded photos.
# SPLAT_BUCKET=faresight-splats   # Public read: the finished splats.
# CDN_BASE_URL=                   # Prefix for splat URLs. Defaults to <endpoint>/<SPLAT_BUCKET>.
# APP_ORIGINS=*                   # Comma-separated origins allowed by the buckets' CORS rules.

# Web app deploy (optional, see "Deploying the web app" in the README). Used by `deploy-web`.
# WEB_BUCKET=faresight-web        # Public read: the built web app. Must not be the raw or splat bucket.
# VULTR_API_KEY=                  # Purges the CDN after an upload.
# VULTR_CDN_PULL_ZONE_ID=         # The pull zone in front of WEB_BUCKET.

# Contributor accounts and the Discover page. Both need DATABASE_URL (the same Tiger Data
# instance the captures use); without it the server starts with accounts and Discover switched
# off and reports that in /api/health rather than failing.
#
# Google sign-in is optional. With GOOGLE_CLIENT_ID unset the Google button never appears and
# email with a password is the only way in. The id must be an OAuth 2.0 *Web* client id from the
# Google Cloud console; the server verifies every ID token's audience against this list, without
# which a Google token issued for any other app would be accepted here.
# GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
# Extra audiences to accept, comma separated: a native iOS or Android build signs in with its own
# client id rather than the web one.
# GOOGLE_CLIENT_IDS=<web-id>,<ios-id>,<android-id>
#
# Google Places supplies the rating shown on a card and the nearby list a contributor picks from.
# It is optional: with no key the nearby search returns nothing, contributors type a name, and
# cards carry no score. Places must be enabled on the Cloud project with billing attached --
# a project without it answers 403 PERMISSION_DENIED.
# GOOGLE_PLACES_API_KEY=
#
# SESSION_DAYS=30              # How long a session lasts before it must be renewed.
# REPORTS_TO_HIDE=3            # Distinct reporters needed to auto-hide a contributed place.
# REGISTRATIONS_PER_HOUR=5     # New accounts per hour from one address.
# PLACES_PER_HOUR=10           # Places added per hour from one address.
