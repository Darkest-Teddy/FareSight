PORT=3001
HOST=0.0.0.0
GEMINI_API_KEY=
# OpenAI gpt-live-1.1 voice assistant (WebRTC Live API + Responses delegation)
OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1.1
# OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
# OPENAI_LIVE_VOICE=ballad
# Atlas scopes: tasks.create, operations.read, assets.create, assets.read.
WLT_API_KEY=
